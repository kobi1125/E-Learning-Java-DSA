<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="#FFFAF0">

        <!-- Lottie Animation -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieCongrats"
            android:layout_width="200dp"
            android:layout_height="200dp"
            app:lottie_rawRes="@raw/congrats"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            android:layout_marginBottom="16dp" />

        <!-- Congratulations Title -->
        <TextView
            android:id="@+id/tvCongrats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎉 Congratulations!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <!-- Message -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You’ve completed all modules and earned your certificate!"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:textAlignment="center" />

        <!-- ✅ The Button that wasn't showing -->
        <Button
            android:id="@+id/btnDownloadCertificate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Download Certificate"
            android:layout_gravity="center"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/tvCertificateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Certification Title"
            android:textSize="18sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvCertificateDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Issued Date"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />


    </LinearLayout>
</ScrollView>
